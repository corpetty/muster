# Pebbles runtime locks — transient, one per `pb` invocation, left behind on
# exit. The SQLite cache beside them is already ignored by `.pebbles/.gitignore`,
# which pebbles ships and owns; this file stays ours.
.pebbles/*.lock

# Nix build outputs — `nix build '.#module'` / '.#ui' symlink these into the
# worktree (see CLAUDE.md § Commands).
result
result-*

# `make run` / `make build` per-peer state and the runner GC-root (root Makefile).
.run/

# Machine-local flake locks: module/ and ui/ pin logos-module-builder to a
# LOCAL path input (the Nim-codegen checkout), so their flake.lock is per-machine
# and must not enter shared history. Committing one breaks the build on any box
# without that exact checkout. Re-pin to a github ref (and commit the lock) once
# the Nim path lands upstream.
module/flake.lock
ui/flake.lock
.rtamt-venv/
