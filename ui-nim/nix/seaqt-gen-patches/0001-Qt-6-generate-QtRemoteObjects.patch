From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: t3 <t3@local>
Date: Tue, 29 Sep 2026 12:43:33 -0400
Subject: [PATCH 1/3] Qt 6: generate QtRemoteObjects

---
 cmd/genbindings/config-libraries.go  | 2 ++
 docker/genbindings-qt6.11.Dockerfile | 2 +-
 docker/genbindings-qt6.4.Dockerfile  | 2 +-
 docker/genbindings-qt6.5.Dockerfile  | 2 +-
 docker/genbindings-qt6.8.Dockerfile  | 2 +-
 5 files changed, 6 insertions(+), 4 deletions(-)

diff --git a/cmd/genbindings/config-libraries.go b/cmd/genbindings/config-libraries.go
index 2411f5e62c97..3e6e116c6e17 100644
--- a/cmd/genbindings/config-libraries.go
+++ b/cmd/genbindings/config-libraries.go
@@ -100,6 +100,8 @@ func buildQt6(clangBin, outDir, extraLibsDir, qtVersion string) {
 
 		"Pdf", "PdfWidgets", "Positioning",
 
+		"RemoteObjects",
+
 		"StateMachine",
 
 		"Designer", "UiPlugin", "UiTools",
diff --git a/docker/genbindings-qt6.11.Dockerfile b/docker/genbindings-qt6.11.Dockerfile
index 0b9a59eb1bd0..45834ceafa6f 100644
--- a/docker/genbindings-qt6.11.Dockerfile
+++ b/docker/genbindings-qt6.11.Dockerfile
@@ -5,7 +5,7 @@ ENV QT_ARCH=gcc_64
 
 RUN \
     /aqtinstall/bin/aqt install-qt linux desktop ${QT6_VERSION} linux_${QT_ARCH} \
-        -m qtmultimedia qtpdf qtpositioning qtscxml qtwebchannel qtwebengine qtwebsockets \
+        -m qtmultimedia qtpdf qtpositioning qtremoteobjects qtscxml qtwebchannel qtwebengine qtwebsockets \
         --outputdir /opt/Qt && \
     rm -rf /root/.cache
 
