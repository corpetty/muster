class ChatBackend
{
    ENUM ChatStatus {
        Stopped = 0,
        Initialising = 1,
        Online = 2,
        Error = 3
    }

    PROP(ChatStatus chatStatus READONLY)
    // This account's own address, the string a peer needs to reach it. Fetched
    // once the module comes online, so the view can show it from first paint.
    PROP(QString myAddress READONLY)
    // Short form of myAddress, on the same rule as a roster row's label, and
    // the two-letter form its avatar carries.
    PROP(QString myLabel READONLY)
    PROP(QString myInitials READONLY)
    PROP(QString currentConversationId)
    // The conversation whose messages and roster the models currently hold.
    // Empty while a selection is being loaded, so the view can tell a loaded
    // thread from the rows of the conversation left behind.
    PROP(QString loadedConversationId READONLY)
    // Derived from the current conversation, kept here (not read off the model)
    // because the models reach QML as QtRO replicas that don't proxy the model's
    // Q_INVOKABLE lookups (isGroupFor/displayNameFor/descriptionFor).
    PROP(bool currentIsGroup READONLY)
    PROP(QString currentDisplayName READONLY)
    PROP(QString currentDescription READONLY)
    // The current conversation's avatar identity, on the same rule as the
    // conversation model's rows.
    PROP(QString currentAvatarInitials READONLY)
    PROP(int currentAvatarRamp READONLY)
    // How many members the current conversation has committed; pending invites
    // are listed in memberModel but not counted here. Exposed as a property (not
    // read off memberModel) because the model reaches QML as a QtRO replica
    // whose rowCount() a non-view caller can't rely on.
    PROP(int memberCount READONLY)
    // Members invited into the current group and awaiting its commit.
    PROP(int pendingMemberCount READONLY)
    // The other participant's address in the current direct conversation, empty
    // for a group or while the roster is unknown.
    PROP(QString currentPeerAddress READONLY)
    // The directory this run's logs are in — the chat module's instance
    // directory, which this view borrows for want of one of its own. Empty when
    // no log was opened, which is what leaves the view with none to offer.
    PROP(QString logDir READONLY)
    // The runs that directory holds, newest first within a writer, one map per
    // run: `writer` naming who wrote it ("chat_ui" or "chat_module"), `label`,
    // `sizeLabel` and `fileCount` for display, `path` for the file being written,
    // `paths` for all of them one per line, and `current` for the run in
    // progress.
    PROP(QVariantList logRuns READONLY)
    // Every failure this run reported, newest first, one map per entry: `when`,
    // `message`, and `count` for a message that repeated.
    PROP(QVariantList errors READONLY)

    // ── journey ──────────────────────────────────────────────────────────
    // Where this conversation has got to in the transaction, and how it got
    // there. Both are read back off the thread rather than tracked alongside
    // it, so they cannot disagree with what is on screen.
    //
    // One of "discovery" | "conversation" | "address" | "payment". A step is
    // reached when its evidence appears and never un-reached.
    PROP(QString journeyStep READONLY)
    // What happened, oldest first, one map per milestone: `step`, `what` (a
    // sentence for the user), and `atMs`.
    PROP(QVariantList journeyTrail READONLY)

    // The home surface: one row per conversation, ordered by what it wants
    // from you — needs-you, then waiting, then settled, then idle — and most
    // recent first inside each band. Each row carries `conversationId`,
    // `displayName`, `avatarInitials`, `avatarRamp`, `action`, `state`,
    // `detail` and `lastActivityMs`.
    //
    // This is what the app opens on. People come back to do something, so the
    // first thing they see is what there is to do, with who it is with as the
    // context rather than the index.
    PROP(QVariantList actions READONLY)

    // ── intents ──────────────────────────────────────────────────────────
    // Every proposal in the open conversation, oldest first. One map each:
    // `intentId`, `amount`, `denom`, `rail`, `railName`, `discloses`, `keys`
    // (the destination address, whatever form the rail takes), `label`,
    // `threshold`, `members`, `proposer` (address), `proposedByMe`, `approvals`
    // (count), `approvedByMe`, `approvers` (list of {label, initials, ramp,
    // isMe}), `state`, `reason`, `tx`, `atMs`.
    //
    // `rail` comes off the proposal card, so the terms the room approved are
    // the terms it is read back with. `railName` and `discloses` are this
    // build's words for that rail, or empty for one it does not know — a peer
    // may propose on a rail we have never heard of, and the card says so rather
    // than describing it wrongly.
    //
    // `state` is one of "proposed" | "collecting" | "ready" | "final" |
    // "dropped" — the prototype's rail, minus the submitted step, because a
    // shielded transfer gives us no observable moment between "sent" and
    // "accepted" to render as its own state.
    PROP(QVariantList intents READONLY)
    // The one proposal the room is currently about, or an empty map. Same
    // shape as an `intents` row. Pinned above the thread (U-3).
    PROP(QVariantMap liveIntent READONLY)

    // ── wallet (lez_core) ────────────────────────────────────────────────
    // The execution-zone wallet this instance owns. Separate from chatStatus:
    // the conversation works whether or not the wallet ever opens, and saying
    // so on screen is cheaper than pretending one implies the other.
    ENUM WalletStatus {
        WalletClosed = 0,
        WalletOpening = 1,
        WalletReady = 2,
        WalletError = 3
    }
    PROP(WalletStatus walletStatus READONLY)
    // True while a zone call is in flight. Zone work is synchronous and can run
    // for minutes (zk proving), so the view needs this to stay honest about a
    // window where nothing appears to happen.
    PROP(bool walletBusy READONLY)
    // What the wallet is doing right now — "syncing", "mining", "claiming",
    // "shielding", "sending". Shown verbatim; a stage the user can name is a
    // stage they can wait out.
    PROP(QString walletStage READONLY)
    // A one-line name for the long-running thing in flight — "Paying 100 LEZ",
    // "Funding" — or empty when nothing is. Separate from `walletStage`, which
    // says which part of it is happening: the job outlives the stages, and the
    // view times it from when this becomes non-empty. A private payment takes
    // minutes of proving, so it is a job you started, not a button you are
    // waiting on, and the interface should say which.
    PROP(QString walletJob READONLY)
    PROP(QString walletError READONLY)

    // ── what this wallet holds, and how it can pay ───────────────────────
    // Both come from the catalogue in ChatBackendAssets.cpp, which is the one
    // place either is added to. Nothing downstream branches on a particular
    // asset: a view that needs to know something about one reads it off the
    // row, so a new entry appears everywhere without a view being touched.
    //
    // One map per balance this wallet can hold, in the order the catalogue
    // declares them: `id`, `name`, `denom`, `sourceNote` (where the money
    // actually is), `balance` (decimal string, the shape the zone returns, and
    // empty until the first read lands — which is not the same as zero),
    // `address` (what a peer would pay it at, empty when it cannot receive),
    // `addressForm`, `canReceive`, `canClaim`, `claimVerb`, `empty`.
    PROP(QVariantList assets READONLY)
    // One map per way this wallet can pay, most private first: `id`, `name`,
    // `promise` (the sentence shown at the moment of payment), `denom`,
    // `source` and `sourceName` and `balance` (the holding it spends), `payTo`
    // (the form of address it can pay — 0 shielded keys, 1 public account id),
    // `claimId`, and `discloses` — `{amount, payer, payee, nothing,
    // everything}`, what the chain learns.
    //
    // `discloses` is the same struct the receipt and the visibility panel read,
    // so what a rail promises before a payment and what it admits afterwards
    // cannot disagree. A rail with no `claimId` never reaches this list.
    PROP(QVariantList rails READONLY)
    // True when the private balance includes an account this wallet did not
    // create — i.e. money has been received. That is how a shielded payment
    // always arrives: the sender picks the identifier, so the note lands at a
    // fresh account under our key node and the balance is a scan rather than a
    // lookup. The flag is what lets the wallet card say so where the number is,
    // rather than leaving a surprising figure unexplained — and it is permanent,
    // because the behaviour is the design and not a bug being waited out.
    PROP(bool receivedElsewhere READONLY)
    // The recovery phrase, set once when this instance mints a new wallet and
    // never read back from storage. Shown once, then the view is expected to
    // stop displaying it.
    PROP(QString newWalletMnemonic READONLY)

    // Open the wallet for this instance, creating one if none exists. Safe to
    // call more than once.
    SLOT(void openWallet())
    // Claim from the zone's PoW faucet and shield the prize into the private
    // account, so the balance that funds a payment is already private.
    SLOT(void fundWallet())
    SLOT(void refreshBalances())
    // Ask the peer for somewhere to pay.
    SLOT(void requestAddress(QString conversationId))
    // Answer that ask with the address for one of this wallet's holdings. The
    // asset is named because there is more than one answer: a shielded key set
    // and a public account id are paid by different rails, and the card has to
    // say which it carries or the payer has to guess.
    SLOT(void shareAddress(QString conversationId, QString assetId))
    // Pay `amount` to the address from an address-share card on the named rail,
    // then post the receipt into the same conversation. The rail decides what
    // the chain learns, so it is chosen, never defaulted silently.
    SLOT(void sendPayment(QString conversationId, QString railId, QString toAddress,
                          QString amount))
    // Move a holding that is owed into one that can be spent — the vault into
    // the private account. Only for a holding whose row says canClaim.
    SLOT(void claimHolding(QString assetId, QString amount))

    // Put a payment to the room before making it. `threshold` is how many
    // members must approve — the proposer's own approval is counted, so a
    // threshold of 1 is a proposal that is immediately ready, not a send.
    //
    // The rail is part of the terms: the room is agreeing to a payment that
    // discloses a particular set of things, and settling it on a different rail
    // would be settling something else.
    SLOT(void proposePayment(QString conversationId, QString railId, QString toAddress,
                             QString label, QString amount, int threshold))
    // Add this member's approval. Approving twice is not two approvals: the
    // fold deduplicates by author.
    SLOT(void approveIntent(QString conversationId, QString intentId))
    // Abandon a proposal. Anyone in the room may; the thread records who.
    SLOT(void dropIntent(QString conversationId, QString intentId, QString reason))
    // Pay a proposal that has reached its threshold. Only the proposer can:
    // the money leaves their account, so nobody else's approval can spend it.
    SLOT(void submitIntent(QString conversationId, QString intentId))

    SLOT(void createConversation(QString peerAddress))
    // Start something with someone: open a conversation and let the verb act.
    // "request" sends the ask for an address as the room's first message, so
    // choosing the activity up front actually does the first step rather than
    // just labelling the room. verb is "pay" | "request" | "talk".
    SLOT(void startActivity(QString verb, QString peerAddress))
    SLOT(void createGroupConversation(QString name, QString description))
    SLOT(void addGroupMember(QString conversationId, QString peerAddress))
    SLOT(void sendMessage(QString conversationId, QString content))
    SLOT(void selectConversation(QString conversationId))
    SLOT(void refreshMembers())
    // Re-reads the log directory, both writers' runs. The files grow, rotate and
    // get pruned while the app runs, so the view asks for a fresh list when it is
    // about to show one rather than holding what the last read found.
    SLOT(void refreshSessionLogs())

    // A message the module refused, so the composer can offer the text back.
    SIGNAL(sendFailed(QString conversationId, QString content))
    SIGNAL(error(QString message))
}
