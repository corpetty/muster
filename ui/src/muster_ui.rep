// The view contract (QtRO). SLOTs are callable from QML; PROPs auto-sync to
// every QML replica, so results reach the view with no polling. The backend is
// the only writer of PROPs; QML only reads them.
class MusterUi
{
    SLOT(void checkHealth())
    SLOT(void loadAccount())

    // Settings — the user-configurable infrastructure (invariant 8). loadSettings
    // reads {rpc, delivery, environment, identity}; setSetting(key,value) repoints
    // the RPC or the delivery createNode config. Both land on settingsJson.
    SLOT(void loadSettings())
    SLOT(void setSetting(const QString &key, const QString &value))

    SLOT(void propose(const QString &effectJson))

    // Add one owner signature (65-byte hex) over the current intent's safeTxHash.
    // The client holds no keys — the owner signs on their own device and the hex
    // is handed in here. The module verifies it recovers to an owner before it
    // counts toward the threshold, and returns the new lifecycle state.
    SLOT(void approve(const QString &signatureHex))

    // Submit the executable intent on-chain: the module assembles the Safe
    // execTransaction from the collected signatures, sends it through the user's
    // RPC, and watches the receipt. Advances submitted → final.
    SLOT(void submit())

    // Clear the current intent from the view so the walkthrough can start fresh.
    // A UI-only reset of the intent PROPs; the module keeps its own log.
    SLOT(void reset())

    // Refresh the wallet balances across every configured chain. Result lands on
    // the balancesJson PROP: a JSON array of {chain, account, asset, display, raw,
    // grade} — or {..., error} for a read that could not be answered (never a
    // false zero). `grade` is "attested" (trusts the RPC) or "verified-locally"
    // (checked against a consensus state root) — the view renders it as a badge.
    SLOT(void loadBalances())

    // ── send assets via Logos (the LEZ, Mode A: request → share → send) ──────
    // Every wallet account (wallet_accounts) into walletAccountsJson — {chain, form,
    // id, share?}. A LEZ account's `share` is the address to hand out to be paid: a
    // public id, or a shielded key node "priv:<npk>:<vpk>". Which you share is your
    // own disclosure choice — the receiver decides how much they reveal.
    SLOT(void loadWalletAccounts())

    // Preview a LEZ send WITHOUT committing (wallet_estimate_fee): names the rail and
    // what it would disclose {amount, payer, payee}, so the sender sees the honesty
    // first — a public destination names the payee, a shielded key node doesn't. Lands
    // on lezPreviewJson.
    SLOT(void previewLezSend(const QString &fromId, const QString &to, const QString &raw))

    // Send on the LEZ (wallet_send, chain lez:testnet, asset LEZ). The rail follows
    // from (source form, destination kind); the result carries {txId, rail, discloses}
    // or {error}, landing on lezSendJson. Accounts refresh after.
    SLOT(void sendLez(const QString &fromId, const QString &to, const QString &raw))

    // ── the room / conversation surface ──────────────────────────────────
    // Join (or start) a conversation on a content topic, over encrypted
    // transport (coordinate_join). Sets roomTopic and loads its messages+members.
    SLOT(void joinRoom(const QString &topic))

    // Post an authored event to the joined room (coordinate_post_message): plain
    // chat text, or a typed card as JSON {kind,...}. One channel; cards are data.
    SLOT(void postMessage(const QString &body))

    // Refresh the room's message log (coordinate_messages) into messagesJson, and
    // the roster (coordinate_members) into membersJson. Each drives inbound
    // delivery first so it reflects events from other participants.
    SLOT(void loadMessages())
    SLOT(void loadMembers())

    // Every joined conversation (coordinate_conversations) into conversationsJson —
    // {topic, address, lastTs, active}. The home surface lists them; opening one
    // re-joins (re-activates) that room. Multi-room: the module holds a session each.
    SLOT(void loadConversations())

    // ── the membership handshake (grow the room) ─────────────────────────────
    // Two instances that both coordinate_join one topic each found their OWN
    // single-member epoch — they can't read each other until one admits the other.
    // requestJoin announces our encryption key on the topic (coordinate_request_join,
    // no authority — discovery, not entry). loadPending reads the askers not yet
    // admitted (coordinate_pending) into pendingJson. admit re-keys the room forward
    // and grants the joiner the new epoch key (coordinate_admit) — the joiner reads
    // from its epoch on, never earlier (F-16). This is what makes two hosts converge.
    SLOT(void requestJoin())
    SLOT(void loadPending())
    SLOT(void admit(const QString &identityHex))

    // The address book (contacts + aliases). loadContacts reads the persisted book
    // (contacts) into contactsJson; add/rename/remove edit it (contact_add /
    // contact_set_alias / contact_remove) and refresh the prop. The module resolves
    // these aliases into membersJson/pendingJson, so the roster shows names.
    SLOT(void loadContacts())
    SLOT(void addContact(const QString &identityHex, const QString &alias))
    SLOT(void setContactAlias(const QString &identityHex, const QString &alias))
    SLOT(void removeContact(const QString &identityHex))

    // Room intents (the multi-party path). Propose an effect into the joined room
    // (coordinate_propose), contribute an owner signature (coordinate_contribute),
    // and read the folded intent list (coordinate_intents) into intentsJson — the
    // room's proposals as reduce(log), interleaved with messages by the view.
    SLOT(void proposeInRoom(const QString &effectJson))
    SLOT(void contributeInRoom(const QString &intentId, const QString &signatureHex, const QString &keyRef))
    SLOT(void loadIntents())

    // The room's coordination history (coordinate_activity): a plain-language
    // narrative of every state transition — proposed, approved (M of N), ready,
    // submitted, settled — folded from the SAME log, in causal order. Lands on
    // activityJson. The education seam: see how the room reached its state.
    SLOT(void loadActivity())

    // Settle a ready room intent on-chain FROM the room (coordinate_submit): assemble
    // the Safe execTransaction from the owner signatures folded on the shared log,
    // submit through the user's RPC, and observe finality. The result lands on
    // roomSubmitJson ({state, onchain, txHash} or {error}); intents reload after.
    SLOT(void submitInRoom(const QString &intentId))

    // Choose the room's coordination policy — its DRIVER (coordinate_set_policy):
    // "safe" (EIP-712 / secp owners) or "threshold" (k-of-n Ed25519). The whole
    // propose/contribute/fold path runs under whichever; the policy is a driver, not
    // hardcoded (invariant 6). Result lands on policyJson {policy, threshold, domain,
    // membership}. loadPolicy reads the current one (coordinate_policy).
    SLOT(void setPolicy(const QString &kind))
    SLOT(void loadPolicy())

    // The driver kinds the room may use (coordinate_drivers): driver-as-proposal.
    // The founding set plus any kind an approved add-driver governance intent admitted.
    // Lands on driversJson; the policy pickers offer only these.
    SLOT(void loadDrivers())

    // ── generic module actions (the invoke driver, P-D4) ─────────────────────
    // Discover the coordinatable actions your loaded modules expose
    // (coordinate_available_actions): the things you can DO together, beyond a Safe
    // payment. Lands on availableActionsJson as [{module, method, signature, params,
    // allowed}] — `allowed` marks what the invoke allowlist will actually execute.
    // The composer renders these as an action menu; picking one composes an invoke
    // intent the room coordinates exactly like any other proposal.
    SLOT(void loadAvailableActions())

    // Execute a generic module-action intent FROM the room (coordinate_execute): the
    // invoke-policy counterpart to submitInRoom. For an invoke intent that reached
    // executable (the room endorsed it k-of-n), the core re-derives, gates (allowlist
    // + the target's capability), invokes module.method(args), and publishes
    // submit+final so every fold converges. The result ({state, executed, detail} or
    // {error}) lands on executeJson; intents reload. The driver never invokes (inv 3).
    SLOT(void executeInRoom(const QString &intentId))

    // Liveness of the infrastructure the room relies on (connectivity): probes the
    // RPC endpoint and the delivery node, landing {rpc, delivery} on connectivityJson.
    // Refreshed on a slower cadence than the message tick (the RPC probe blocks).
    SLOT(void loadConnectivity())

    // The room's sending context for the composer (coordinate_account): what an intent
    // here would move (the Safe's live balance — what's available to send) and who you
    // act as (your owner address + whether it's a real Safe owner). Lands on
    // roomAccountJson. Ask-then-disclose: called when the composer opens, not on entry.
    SLOT(void loadRoomAccount())
    // The proposal card's five questions + THIS instance's readiness for one room
    // intent (coordinate_readiness, exo-002.3): what it will do, what is needed (each
    // requirement met / missing / unknown with a remedy), what it touches, what will
    // happen (the full disclosure, store node included), how we agree. Lands on
    // readinessJson keyed by intent id. Probes the RPC, so the card asks on demand
    // (when its "What this needs" box opens), not on the message tick.
    SLOT(void loadReadiness(const QString &intentId))
    // The card's "From you" section for one intent (coordinate_offers, exo-45e K6):
    // which of MY OWN holdings can fill the slots this proposal asks of me — the
    // contributor keys and any counterparty address/asset the effect still needs.
    // Lands on offersJson keyed by intent id. Graded about me only (invariant 9).
    SLOT(void loadOffers(const QString &intentId))
    // The composer's third step (compose_offers, exo-45e K6/exo-fa1): for a DRAFT effect
    // under the room's compose policy, which of my holdings fill the PROPOSER slots — the
    // asset+amount to send. Lands on composeOffersJson. Graded about me only.
    SLOT(void loadComposeOffers(const QString &effectJson))
    // Share one of my holdings into an intent to fill a slot (coordinate_share_material):
    // `pub` is the PUBLIC face of a candidate from loadOffers (the handle never leaves
    // the module, s1). Publishes a material-share event; offers reload after.
    SLOT(void shareMaterial(const QString &intentId, const QString &requirement, const QString &pub))
    // Decline to take part in a room intent (coordinate_decline): a signed decline
    // event folded into the intent view — named under a named driver, a count under
    // an anonymous one. Informational: the threshold is unchanged. Lands on
    // declineJson {intentId, state, declines} or {error}; intents reload after.
    SLOT(void declineInRoom(const QString &intentId))
    // The information-flow view (coordinate_flow, exo-002.5): who could see what,
    // for every action — {rows:[{seq,kind,intentId,field,to,members,epoch,declared}],
    // matrix:{observer:[fields]}}. A fold over the sealed log (no RPC), refreshed on
    // the slower tick. Lands on flowJson.
    SLOT(void loadFlow())

    PROP(QString health="unknown" READONLY)

    // The user-configurable settings + identity, as JSON {rpc, delivery, environment,
    // identity:{address,ed25519,x25519}}. The Settings surface shows and edits these.
    PROP(QString settingsJson="{}" READONLY)

    // The Safe account this walkthrough coordinates against — read from the
    // module's describe(), never assumed by the view. JSON: {chainId, safe,
    // threshold, owners, environment}.
    PROP(QString accountJson="" READONLY)

    // The current intent. One at a time, single instance. All from the module:
    // intentEffect is the JSON that was proposed (what the strip shows), and
    // intentTxhash is the EIP-712 safeTxHash the module re-derived from it (the
    // exact bytes each owner will sign — what the strip re-derives).
    PROP(QString intentId="" READONLY)
    PROP(QString intentEffect="" READONLY)
    PROP(QString intentTxhash="" READONLY)
    PROP(QString intentState="" READONLY)
    PROP(QString lastError="" READONLY)

    // Wallet balances across chains, as JSON (see loadBalances). Each entry carries
    // its F-10 grade so the view can show what is proven vs merely claimed.
    PROP(QString balancesJson="[]" READONLY)

    // Wallet accounts (loadWalletAccounts) — [{chain, form, id, share?}]. The LEZ send
    // panel lists your shareable addresses from the `share` field.
    PROP(QString walletAccountsJson="[]" READONLY)

    // The last LEZ send preview (previewLezSend): {rail, discloses:{amount,payer,payee},
    // fee, note} or {error}. The panel shows the honesty before you commit.
    PROP(QString lezPreviewJson="{}" READONLY)

    // The last LEZ send outcome (sendLez): {txId, rail, discloses, fee} or {error}.
    PROP(QString lezSendJson="{}" READONLY)

    // The joined room's topic (empty until joinRoom), its message log as a JSON
    // array of {id, author, ts, body}, and its admitted roster as {identity, self}.
    // The view folds messagesJson into the thread (and, later, the cards/journey).
    PROP(QString roomTopic="" READONLY)
    PROP(QString messagesJson="[]" READONLY)
    PROP(QString membersJson="[]" READONLY)
    PROP(QString contactsJson="[]" READONLY)
    PROP(QString intentsJson="[]" READONLY)

    // The room's coordination history (coordinate_activity), as a JSON array of
    // {seq, kind, intentId, account, title, detail} in causal order. The room
    // renders it as a live "how we got here" feed.
    PROP(QString activityJson="[]" READONLY)

    // Liveness of the room's infrastructure (connectivity), as JSON
    // {rpc:{name,level,endpoint,detail}, delivery:{name,level,detail}}. level is
    // ok/warn/down; the room renders each as a status indicator (invariant 8).
    PROP(QString connectivityJson="{}" READONLY)

    // The room's sending context for the composer (coordinate_account), as JSON
    // {policy, account, actingAs, isOwner, assets:[{symbol,decimals,display,raw|error}]}.
    // The composer shows what's available to send + who you act as, at propose time.
    PROP(QString roomAccountJson="{}" READONLY)

    // The outcome of the last room-side submit (coordinate_submit): JSON
    // {state, onchain, txHash} on success, or {error, ...}. The room shows it on the
    // ready card so settling on-chain reports honestly (never a false "landed").
    PROP(QString roomSubmitJson="{}" READONLY)
    // Readiness per intent (loadReadiness): a JSON object {<intentId>: {intentId,
    // policy, effect, declared, ready, unknown, items:[{kind,name,scope,status,
    // detail,remedy}], manifest:{agreement, requirements, discloses, touches}}}.
    // The card renders its five questions + readiness from its own entry.
    PROP(QString readinessJson="{}" READONLY)
    // Offers per intent (loadOffers, exo-45e K6): a JSON object {<intentId>: {intentId,
    // ready, offers:[{requirement:{kind,name,party,field}, status, candidates:[{public,
    // class, form, grade, discloses:[{field,to}]}]}]}}. The card's "From you" picker
    // renders its own entry; a pick calls shareMaterial with the candidate's public face.
    PROP(QString offersJson="{}" READONLY)
    // The composer's proposer offers for a draft effect (loadComposeOffers): {ready,
    // offers:[{requirement, status, candidates:[{public, class, form, grade, discloses}]}]}.
    // The composer's third step renders the asset/amount picker from its own entry.
    PROP(QString composeOffersJson="{}" READONLY)
    // The outcome of the last decline (declineInRoom): {intentId, state, declines}
    // or {error}, so the card can say whether the decline folded.
    PROP(QString declineJson="{}" READONLY)
    // The room's information flow (loadFlow): {rows, matrix}. The Room renders the
    // observer matrix + per-action rows; the store node is always present (FS-9).
    PROP(QString flowJson="{\"rows\":[],\"matrix\":{}}" READONLY)

    // The room's coordination policy — its driver — as JSON {policy, threshold,
    // domain, membership}. The view shows which policy governs the room and picks it.
    PROP(QString policyJson="{\"policy\":\"safe\"}" READONLY)

    // The room's admitted driver kinds (coordinate_drivers), as a JSON array of
    // strings. Grows by approved add-driver proposal (driver-as-proposal, invariant 6).
    PROP(QString driversJson="[\"safe\",\"threshold\"]" READONLY)

    // The coordinatable module actions available to the room (loadAvailableActions),
    // as a JSON array of {module, method, signature, params, allowed}. The composer's
    // action menu renders these; picking one composes an invoke intent.
    PROP(QString availableActionsJson="[]" READONLY)

    // The outcome of the last room-side invoke execution (executeInRoom): JSON
    // {state, executed, detail} on success, or {error, ...}. The room shows it on the
    // ready invoke card so running the action reports honestly.
    PROP(QString executeJson="{}" READONLY)

    // The outcome of the last in-app approval (contributeInRoom): JSON
    // {intentId, state, ok, reason}. `ok` is false when the signature didn't count —
    // "rejected" (your key isn't a recognized signer for this policy), "not-joined",
    // "unknown-intent" — so the UI can say WHY instead of silently doing nothing.
    PROP(QString contributeJson="{}" READONLY)

    // Every joined conversation, as JSON {topic, address, lastTs, active}. The home
    // surface lists these — one row per room the module holds a session for.
    PROP(QString conversationsJson="[]" READONLY)

    // Join-requests not yet admitted (coordinate_pending): a JSON array of
    // {identity, bindsOwner} — 64-byte encryption identity hex, and whether its
    // binding recovers to a Safe owner (F-9). The scope panel lists these with an
    // Admit action; admitting re-keys the room forward (F-16).
    PROP(QString pendingJson="[]" READONLY)
}
