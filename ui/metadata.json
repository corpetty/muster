{
  "name": "muster_ui",
  "display_name": "Muster",
  "version": "0.2.0",
  "type": "ui_qml",
  "interface": "universal",
  "category": "general",
  "description": "Muster: rooms where people agree on a payment, a bill split or a decision together, then settle it. Every card shows what is needed, who can see what, and what you are signing.",
  "main": "muster_ui_plugin",
  "icon": "src/icons/icon.png",
  "view": "qml/Main.qml",
  "dependencies": [
    {
      "name": "muster_module",
      "version": "~0.2.0"
    },
    {
      "name": "delivery_module",
      "version": "~0.3.2"
    },
    {
      "name": "lez_core",
      "version": "~0.5.0"
    },
    {
      "name": "keystore_module",
      "version": "~0.1.0"
    },
    {
      "name": "eth_rpc_module",
      "version": "~0.1.0"
    },
    {
      "name": "tx_sender_module",
      "version": "~0.1.0"
    },
    {
      "name": "fee_module",
      "version": "~0.1.0"
    },
    {
      "name": "liblogos_lez_rln_module",
      "version": "~4.2.1"
    },
    {
      "name": "liblogos_rln_module",
      "version": "~0.10.0"
    }
  ],
  "codegen": {
    "rep": "src/muster_ui.rep"
  },
  "nix": {
    "packages": {
      "build": [],
      "runtime": []
    },
    "external_libraries": [],
    "cmake": {
      "find_packages": [],
      "extra_sources": [],
      "extra_include_dirs": [],
      "extra_link_libraries": []
    }
  },
  "provides": [
    {
      "intent": "coordinate.request",
      "params": [
        {
          "name": "capability",
          "type": "string",
          "required": true
        },
        {
          "name": "payload",
          "type": "string",
          "required": true
        },
        {
          "name": "room",
          "type": "string",
          "required": false
        }
      ]
    }
  ],
  "uses": [
    {
      "intent": "evm.signing.approve"
    },
    {
      "intent": "evm.accounts.manage"
    },
    {
      "intent": "evm.rpc.configure"
    },
    {
      "intent": "packages.install"
    },
    {
      "intent": "packages.show"
    }
  ]
}
