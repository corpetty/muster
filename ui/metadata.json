{
  "name": "muster_ui",
  "display_name": "Muster",
  "version": "0.1.0",
  "type": "ui_qml",
  "interface": "universal",
  "category": "general",
  "description": "Muster coordination UI (P4 loading spike): reads muster_module.health() through the generated logos-API client and shows it in QML.",
  "main": "muster_ui_plugin",
  "icon": "src/icons/icon.png",
  "view": "qml/Main.qml",
  "dependencies": [
    "muster_module",
    "delivery_module",
    "lez_core",
    "keystore_module",
    "eth_rpc_module",
    "tx_sender_module",
    "fee_module",
    "liblogos_lez_rln_module",
    "liblogos_rln_module"
  ],
  "codegen": {
    "rep": "src/muster_ui.rep"
  },
  "nix": {
    "packages": {
      "build": [],
      "runtime": []
    },
    "external_libraries": [],
    "cmake": {
      "find_packages": [],
      "extra_sources": [],
      "extra_include_dirs": [],
      "extra_link_libraries": []
    }
  },
  "provides": [
    {
      "intent": "coordinate.request",
      "params": [
        {
          "name": "capability",
          "type": "string",
          "required": true
        },
        {
          "name": "payload",
          "type": "string",
          "required": true
        },
        {
          "name": "room",
          "type": "string",
          "required": false
        }
      ]
    }
  ],
  "uses": [
    {
      "intent": "evm.signing.approve"
    },
    {
      "intent": "evm.accounts.manage"
    },
    {
      "intent": "evm.rpc.configure"
    },
    {
      "intent": "packages.install"
    },
    {
      "intent": "packages.show"
    }
  ]
}
