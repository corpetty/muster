module muster_module {
  version "0.1.0"
  description "Muster — local-first client for coordinating multi-party transactions inside conversations. The coordination surface: propose an intent from an effect, approve it with contributions until the driver's threshold is met, and read its lifecycle state. The Nim core behind this contract drives the intent lifecycle engine (draft → proposed → collecting → executable → ...) over the driver interface; this .lidl stays the single normative surface, and the Nim module surface is generated from it (tools/lidl_gen.nim)."

  method health() -> tstr description "Liveness probe. Returns \"ok\" when the module is loaded and dispatching."

  method propose(effect_json: tstr) -> tstr description "Propose an intent from an effect (a JSON object of typed fields, e.g. {\"amount\":100}). Returns the new intent's id."

  method approve(intent_id: tstr, contribution_hex: tstr) -> tstr description "Add a contribution (a hex-encoded signature/attestation) to an intent, advancing its collection. Returns the intent's new lifecycle state."

  method status(intent_id: tstr) -> tstr description "Return an intent's current lifecycle state (draft, proposed, collecting, executable, ...)."
}
